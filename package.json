{
  "name": "inventorize",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @inventorize/web",
    "build": "npm run build -w @inventorize/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "hub": "npm run start -w @inventorize/hub",
    "relay:dev": "npm run dev -w @inventorize/cloud",
    "relay:deploy": "npm run deploy -w @inventorize/cloud"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "fast-check": "^4.11.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
